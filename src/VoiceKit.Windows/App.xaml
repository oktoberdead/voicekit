<Application x:Class="VoiceKit.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#6EE7B7"/>
  <Style TargetType="Window"><Setter Property="Background" Value="#111820"/><Setter Property="Foreground" Value="#E3ECF4"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,5,0,5"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,5,8,5"/><Setter Property="Background" Value="#6EE7B7"/><Setter Property="Foreground" Value="#10221C"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,9,10,9"/><Setter Property="Foreground" Value="#E3ECF4"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="6"/><Setter Property="MinWidth" Value="120"/><Setter Property="Foreground" Value="#15202B"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,0,8"/><Setter Property="Foreground" Value="#15202B"/></Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,5,0,14"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="1"/></Style>
  <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="Padding" Value="14"/><Setter Property="Foreground" Value="#E3ECF4"/><Setter Property="BorderBrush" Value="#344352"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10"/><Setter Property="Foreground" Value="#15202B"/></Style>
 </Application.Resources>
</Application>
