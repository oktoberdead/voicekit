<Window x:Class="VoiceKit.Windows.Calibration.CalibrationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="VoiceKit · лаборатория голоса (эксперимент)" Width="1030" Height="880" MinWidth="790" MinHeight="650"
 WindowStartupLocation="CenterOwner" Closing="WindowClosing">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <TextBlock Text="ЛАБОРАТОРИЯ ГОЛОСА" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
   <TextBlock Text="Эксперимент · записываем до эффектов VoiceKit, сравниваем на одном образце. Форманты и автотюн пока не реализованы." Foreground="#9EAFBE"/>
   <TextBlock Text="Основной аудиодвижок остановлен. Запись только по кнопке; прослушивание — только в наушники, не в VB-CABLE. Основные хоткеи приостановлены, кроме PANIC. После закрытия запусти аудио вручную." Foreground="#FFD38A"/>
   <TextBlock x:Name="DeviceLabel"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <GroupBox Header="1 / Чистый образец · 38 секунд"><StackPanel>
    <TextBlock Text="Сначала 3 секунды молчи, затем следуй подсказкам. Микрофон держи на привычном расстоянии. Не делай голос специально выше или ниже. Обработки Windows/гарнитуры, если включены, останутся в записи."/>
    <WrapPanel><Button x:Name="RecordButton" Content="● Записать новый образец" Click="StartRecording"/><Button x:Name="StopRecordButton" Content="Остановить запись" Click="StopRecording" IsEnabled="False"/><Button x:Name="LoadButton" Content="Открыть профиль…" Click="LoadProfile"/><Button Content="Папка профилей" Click="OpenProfilesFolder"/></WrapPanel>
    <TextBlock x:Name="StageLabel" Text="Готов к записи. Первые 3 секунды — тишина." FontSize="18" Foreground="{StaticResource Accent}"/>
    <Border Background="#1B2530" Padding="14" Margin="0,6,0,8" CornerRadius="6"><TextBlock x:Name="PromptLabel" FontSize="19" Text="Сегодня утром я открыл окно. На улице тихо, а солнце уже светит. Сейчас я говорю своим обычным голосом."/></Border>
    <ProgressBar x:Name="RecordProgress" Minimum="0" Maximum="38" Height="8"/>
    <TextBlock x:Name="RecordLevel" FontFamily="Consolas" Text="00.0 / 38.0 с · микрофон не записывает"/>
   </StackPanel></GroupBox>
   <GroupBox Header="2 / Измерения и стартовая рекомендация"><StackPanel>
    <TextBlock x:Name="AnalysisLabel" Text="Запиши или открой образец. Анализ выполняется локально, вне аудиопотока." FontFamily="Consolas"/>
    <TextBlock x:Name="AnalysisWarnings" Foreground="#FFD38A"/>
    <WrapPanel VerticalAlignment="Center"><TextBlock Text="Желаемая медиана высоты, Гц (80–350):" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="TargetHz" Width="95" Text="180"/><Button x:Name="SuggestButton" Content="Предложить питч для B" Click="SuggestPitch" IsEnabled="False"/></WrapPanel>
    <TextBlock Text="Это ориентир постоянного сдвига от медианы чистого голоса — не выравнивание интонации и не «процент женственности». Вокодер/воббл меняют результат. Периодичность — свойство сигнала, не гарантия точности измерения." Foreground="#9EAFBE"/>
   </StackPanel></GroupBox>
   <GroupBox Header="3 / A/B на одной записи"><StackPanel>
    <CheckBox x:Name="NeutralReference" Content="A: нейтральный, без эффектов (сними флажок, чтобы вернуть снимок эффектов)" Checked="CandidateChanged" Unchecked="CandidateChanged"/>
    <TextBlock x:Name="ReferenceLabel" Text="A: снимок настроек на момент открытия лаборатории"/>
    <TextBlock Text="B: кандидат. Исходно — те же эффекты, что были при открытии окна."/>
    <WrapPanel><CheckBox x:Name="CandidateEnabled" Content="Обработка B включена" Checked="CandidateChanged" Unchecked="CandidateChanged"/><CheckBox x:Name="CandidatePitch" Content="Питч B включён" Checked="CandidateChanged" Unchecked="CandidateChanged"/><CheckBox x:Name="PitchOnly" Content="В B оставить только питч" Checked="CandidateChanged" Unchecked="CandidateChanged"/></WrapPanel>
    <DockPanel><TextBlock Text="Сдвиг B, полутоны"/><TextBlock HorizontalAlignment="Right" Text="{Binding ElementName=CandidateShift, Path=Value, StringFormat=F1}"/></DockPanel>
    <Slider x:Name="CandidateShift" Minimum="-12" Maximum="12" TickFrequency="0.1" ValueChanged="CandidateSliderChanged"/>
    <TextBlock Text="Фрагмент для сравнения"/><ComboBox x:Name="ExcerptBox" SelectionChanged="ExcerptChanged"/>
    <CheckBox x:Name="MatchLevels" Content="Приблизительно выровнять RMS для прослушивания (до −20 dBFS, усиление не больше ×4)" IsChecked="True" Checked="CandidateChanged" Unchecked="CandidateChanged"/>
    <Button x:Name="RenderButton" Content="Подготовить A/B" Click="PrepareComparison" IsEnabled="False" HorizontalAlignment="Left"/>
    <TextBlock x:Name="PreviewInfo" Text="При изменении параметров нужно заново подготовить сравнение. Рендер сравнивает только эффекты: без саундпада, mute и уровней основного микшера. Живые настройки не меняются." Foreground="#9EAFBE"/>
    <WrapPanel><Button x:Name="DryButton" Content="Оригинал" Click="PlayDry" IsEnabled="False"/><Button x:Name="AButton" Content="▶ Вариант A" Click="PlayA" IsEnabled="False"/><Button x:Name="BButton" Content="▶ Вариант B" Click="PlayB" IsEnabled="False"/><Button Content="■ Стоп" Click="StopPreviewClick"/><Button Content="PANIC" Background="#FF9B9B" Click="PanicClick"/></WrapPanel>
    <ProgressBar x:Name="PlaybackProgress" Minimum="0" Maximum="1" Height="6"/>
    <TextBlock x:Name="PlaybackLabel" Text="Переключение A/B идёт с той же позиции, с коротким кроссфейдом. Стоп → воспроизведение начинает фрагмент заново."/>
    <DockPanel><TextBlock Text="Громкость только прослушивания"/><TextBlock HorizontalAlignment="Right" Text="{Binding ElementName=PreviewVolume, Path=Value, StringFormat=P0}"/></DockPanel>
    <Slider x:Name="PreviewVolume" Value="0.35" ValueChanged="PreviewVolumeChanged"/>
   </StackPanel></GroupBox>
   <GroupBox Header="4 / Сохранить эксперимент или применить результат"><StackPanel>
    <TextBlock Text="Название профиля / пресета"/><TextBox x:Name="ProfileName" Text="Мой голос" MaxLength="80"/>
    <WrapPanel><TextBlock Text="Выбранный результат:" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="PreferredBox" Width="170" SelectedIndex="1"><ComboBoxItem Content="Вариант A"/><ComboBoxItem Content="Вариант B"/></ComboBox></WrapPanel>
    <WrapPanel><Button x:Name="SaveButton" Content="Сохранить профиль + WAV…" Click="SaveProfile" IsEnabled="False"/><Button x:Name="ApplyButton" Content="Применить выбранный и закрыть" Click="ApplyResult" IsEnabled="False"/></WrapPanel>
    <TextBlock Text="Профиль сохраняется только по этой кнопке: исходный WAV, анализ и настройки A/B — в локальной папке Calibration. Он содержит твой голос; не публикуй папку без необходимости. Можно удалить папку профиля вручную. «Применить» создаёт обычный пресет эффектов и не сохраняет запись автоматически." Foreground="#9EAFBE"/>
    <TextBlock x:Name="SavedPathLabel"/>
   </StackPanel></GroupBox>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Закрыть без применения" Click="CloseClick" HorizontalAlignment="Right"/><TextBlock x:Name="LabStatus" Text="Готово. Без облака и без обучения моделей." VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
